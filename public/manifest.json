{
  "name": "PrintSafe",
  "short_name": "PrintSafe",
  "description": "Share privately. Delete automatically.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#8EC6E8",
  "theme_color": "#8EC6E8",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["application/pdf", "image/jpeg", "image/png", "image/heic", "image/heif"]
        }
      ]
    }
  }
}
